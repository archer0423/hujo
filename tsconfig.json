{
  "compilerOptions": {
    // "ignoreDeprecations": "6.0",
    "target": "es6",
    "module": "commonjs",
    "experimentalDecorators": true,
    "strict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "stripInternal": true,
    "lib": ["ES2020", "DOM"],
    "types": ["@cocos/creator-types/engine", "@cocos/creator-types/editor"]
  },
  "exclude": ["node_modules", "dist", "build"]
}
